{
  "manifest_version": 3,
  "name": "AI Tab Organizer",
  "description": "AI semantic tab grouping with editable preview, drag-and-drop adjustment, custom rules, adaptive timeout, and cleanup tools.",
  "version": "0.5.0",
  "permissions": ["tabs", "tabGroups", "storage", "scripting"],
  "host_permissions": ["https://*/", "http://*/", "https://api.openai.com/*", "https://api.deepseek.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "AI Tab Organizer",
    "default_popup": "popup.html",
    "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}
  },
  "options_page": "options.html",
  "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}
}
