{
  "manifest_version": 3,
  "name": "AI Tab Organizer PoC",
  "version": "0.1.0",
  "description": "A Chrome Extension PoC that groups current-window tabs by semantic-like categories.",
  "permissions": ["tabs", "tabGroups", "storage"],
  "action": {
    "default_title": "AI Tab Organizer",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
